# ==========================================
# School Bus Dispatch Platform - Environment Configuration Example
# Copy this file to .env and populate your credentials.
# NEVER commit .env to version control!
# ==========================================

# Server & GCP
PORT=8080
GCP_PROJECT_ID=your-gcp-project-id
ALLOWED_ORIGINS=*
ENV=development

# Admin Authentication & Secrets
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeInProduction_Admin123!
ADMIN_API_SECRET=ChangeMeInProduction_ArchiveSecret123!
APPROVAL_SECRET=ChangeMeInProduction_ApprovalSecret123!

# Google Maps Routes API (Server-side only, NEVER expose to client apps)
# If empty, the platform automatically falls back to built-in geometric road interpolation.
GOOGLE_MAPS_API_KEY=

# Twilio (Optional SMS Gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email / Amazon SES Notifications (Optional)
HR_NOTIFICATION_EMAIL=hr@example.com
SYSTEM_NOTIFICATION_EMAIL=noreply@example.com
DISPATCH_FORWARD_EMAIL=dispatch@example.com
PAYROLL_FORWARD_EMAIL=payroll@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
APP_BASE_URL=http://localhost:8080

# Parent App Authentication
PARENT_APP_BASE_URL=http://localhost:5000
PARENT_JWT_SIGNING_KEY=ChangeMeInProduction_Secret123!
