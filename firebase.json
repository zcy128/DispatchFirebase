{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "dispatch-api",
          "region": "northamerica-northeast1"
        }
      },
      {
        "source": "/driver",
        "destination": "/driver/index.html"
      },
      {
        "source": "/driver/**",
        "destination": "/driver/index.html"
      },
      {
        "source": "/parent",
        "destination": "/parent/index.html"
      },
      {
        "source": "/parent/**",
        "destination": "/parent/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
